<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#F8F3EB">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="22dp">

            <TextView
                android:id="@+id/tvHomeGreeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Halo, Nama!"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#493222"
                android:layout_marginBottom="18dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Kopi dan Nyemil ☕"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="#493222" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Good food, good mood!"
                android:textSize="14sp"
                android:textColor="#806B5A"
                android:layout_marginTop="5dp"
                android:layout_marginBottom="15dp" />

            <Button
                android:id="@+id/btnOpenProfile"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="👤 Profil Saya"
                android:textColor="#FFFFFF"
                android:backgroundTint="#493222"
                android:layout_marginBottom="25dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Mau pesan apa hari ini?"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#493222"
                android:layout_marginBottom="15dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="☕ KOPI"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#493222"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/productCappuccino"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="☕ Cappuccino                 Rp 25.000"
                android:textSize="16sp"
                android:textColor="#493222"
                android:padding="16dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/productLatte"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="☕ Cafe Latte                   Rp 23.000"
                android:textSize="16sp"
                android:textColor="#493222"
                android:padding="16dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/productAmericano"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="☕ Americano                   Rp 20.000"
                android:textSize="16sp"
                android:textColor="#493222"
                android:padding="16dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="22dp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🍪 CAMILAN"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#493222"
                android:layout_marginBottom="12dp" />

            <TextView
                android:id="@+id/productCroissant"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🥐 Croissant                     Rp 18.000"
                android:textSize="16sp"
                android:textColor="#493222"
                android:padding="16dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="10dp" />

            <TextView
                android:id="@+id/productRoti"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="🍞 Roti Bakar                   Rp 15.000"
                android:textSize="16sp"
                android:textColor="#493222"
                android:padding="16dp"
                android:background="#FFFFFF"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginBottom="20dp" />

        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="65dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:background="#FFFFFF"
        android:elevation="8dp">

        <TextView
            android:id="@+id/navHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Home"
            android:textStyle="bold"
            android:textSize="14sp"
            android:textColor="#FFFFFF"
            android:background="#493222" />

        <TextView
            android:id="@+id/navOrder"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Order"
            android:textSize="14sp"
            android:textColor="#493222"
            android:background="#FFFFFF" />

        <TextView
            android:id="@+id/navProfile"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Profile"
            android:textSize="14sp"
            android:textColor="#493222"
            android:background="#FFFFFF" />

    </LinearLayout>

</LinearLayout>
