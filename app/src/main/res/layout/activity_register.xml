<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F3EB"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:padding="28dp">

        <TextView
            android:layout_width="100dp"
            android:layout_height="100dp"
            android:text="☕"
            android:textSize="55sp"
            android:gravity="center"
            android:background="@drawable/circle_logo"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Create Account"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#493222"
            android:gravity="center"
            android:layout_marginTop="20dp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Register to enjoy our coffee and snacks"
            android:textSize="14sp"
            android:textColor="#493222"
            android:gravity="center"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="25dp" />

        <EditText
            android:id="@+id/etName"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Full Name"
            android:textColor="#493222"
            android:textColorHint="#806B5A"
            android:padding="14dp"
            android:singleLine="true"
            android:backgroundTint="#806B5A" />

        <EditText
            android:id="@+id/etRegUsername"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Username"
            android:textColor="#493222"
            android:textColorHint="#806B5A"
            android:padding="14dp"
            android:singleLine="true"
            android:layout_marginTop="12dp"
            android:backgroundTint="#806B5A" />

        <EditText
            android:id="@+id/etEmail"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Email Address"
            android:inputType="textEmailAddress"
            android:textColor="#493222"
            android:textColorHint="#806B5A"
            android:padding="14dp"
            android:singleLine="true"
            android:layout_marginTop="12dp"
            android:backgroundTint="#806B5A" />

        <EditText
            android:id="@+id/etRegPassword"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Password"
            android:inputType="textPassword"
            android:textColor="#493222"
            android:textColorHint="#806B5A"
            android:padding="14dp"
            android:singleLine="true"
            android:layout_marginTop="12dp"
            android:backgroundTint="#806B5A" />

        <Button
            android:id="@+id/btnSubmitRegister"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Register Now"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:backgroundTint="#493222"
            android:layout_marginTop="30dp"
            android:layout_marginBottom="25dp" />

    </LinearLayout>

</ScrollView>
